{
  "name": "otel-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal OpenTelemetry HTTP tracing playground",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --require ./instrumentation.cjs app.cjs",
    "test": "node --test test/smoke.test.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-node": "0.57.2",
